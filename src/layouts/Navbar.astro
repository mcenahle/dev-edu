---
const pathname = Astro.url.pathname;

const isActive = (path: string) =>
  pathname === path || pathname.startsWith(`${path}/`);

import { Icon } from "astro-icon/components";
---

<nav
  class="navbar navbar-expand-md bg-dark sticky-top border-bottom"
  data-bs-theme="dark"
>
  <div class="container">
    <a class="navbar-brand d-md-none" href="/">
      <img style="max-width: 24px" src="/favicon.ico" alt="mcenahle.edu.pl" />
      <span style="margin-left: 4px;">mcenahle EDU</span>
    </a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="offcanvas"
      data-bs-target="#offcanvas"
      aria-controls="offcanvas"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div
      class="offcanvas offcanvas-end"
      tabindex="-1"
      id="offcanvas"
      aria-labelledby="offcanvasLabel"
    >
      <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasLabel">mcenahle EDU</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="offcanvas"
          aria-label="Close"></button>
      </div>
      <div class="offcanvas-body">
        <ul class="navbar-nav flex-grow-1 justify-content-between">
          <li class="nav-item">
            <a class="nav-link" href="/" aria-label="mcenahle EDU">
              <img
                style="max-width: 24px"
                src="/favicon.ico"
                alt="mcenahle.edu.pl"
              />
            </a>
          </li>
          <li class="nav-item"><a class="nav-link" href="#">Tour</a></li>
          <li class="nav-item">
            <a
              class={`nav-link ${isActive("/biology") ? "active" : ""}`}
              href="/biology/">生物学</a
            >
          </li>
          <li class="nav-item">
            <a
              class={`nav-link ${isActive("/posts") ? "active" : ""}`}
              href="/posts/">相关文章</a
            >
          </li>
          <li class="nav-item">
            <a
              class={`nav-link ${isActive("/research") ? "active" : ""}`}
              href="/research/">个人迷你小论文</a
            >
          </li>
          <li class="nav-item"><a class="nav-link" href="#">Support</a></li>
          <li class="nav-item"><a class="nav-link" href="#">Pricing</a></li>
          <li class="nav-item">
            <a class="nav-link" href="#" aria-label="Cart">
              <Icon name="bi:cart" />
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</nav>
